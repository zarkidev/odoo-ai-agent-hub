<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_ai" model="ir.module.category">
            <field name="name">AI</field>
            <field name="description">Run AI agents from anywhere in Odoo.</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_ai_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_ai"/>
            <field name="comment">Can run AI agents on records and see the history.</field>
        </record>

        <record id="group_ai_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_ai"/>
            <field name="implied_ids" eval="[(4, ref('group_ai_user'))]"/>
            <field name="comment">Can set up providers and API keys, and create agents.</field>
        </record>

        <!-- Existing system administrators get AI administration automatically. -->
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('group_ai_manager'))]"/>
        </record>

        <!-- Everyone who uses Odoo can run agents; only admins configure them. -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_ai_user'))]"/>
        </record>

    </data>
</odoo>
