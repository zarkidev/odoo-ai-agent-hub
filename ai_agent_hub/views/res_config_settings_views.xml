<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.agent.hub</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="AI" string="AI" data-key="ai_agent_hub">
                    <h2>AI Provider</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="ai_default_provider_id" string="Default provider"/>
                                <div class="text-muted">
                                    Used by new agents. Each agent can still pick a different one.
                                </div>
                                <div class="content-group mt16">
                                    <field name="ai_default_provider_id" options="{'no_create': True}"/>
                                    <field name="ai_provider_state" invisible="1"/>
                                </div>
                                <div class="text-warning mt8"
                                     attrs="{'invisible': ['|', ('ai_provider_state', '=', 'ready'), ('ai_default_provider_id', '=', False)]}">
                                    This provider has not been tested yet.
                                </div>
                                <div class="mt8">
                                    <button name="action_open_ai_providers" type="object"
                                            string="Set up providers" class="btn-link" icon="fa-arrow-right"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
